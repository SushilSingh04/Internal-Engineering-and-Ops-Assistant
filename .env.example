# =============================================================================
# Internal Engineering & Ops Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.

# Groq LLM
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
MAX_AGENT_ITERATIONS=3

# OpenAI (embeddings only)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=engineering-docs

# Supabase Postgres — use the TRANSACTION MODE pooler string (port 6543)
# Format: postgresql://postgres.<ref>:<password>@<host>:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Tavily Web Search
TAVILY_API_KEY=tvly-...

# Webhook HMAC-SHA256 secret (shared with GitHub/GitLab)
WEBHOOK_SECRET=your-webhook-secret-here

# Ingestion
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
# CLONE_DIR auto-detects via tempfile (Windows: AppData/Local/Temp, Linux: /tmp)
# Only set this if you want a custom location:
# CLONE_DIR=C:\custom\path\repos

# Trace logging
TRACE_DIR=traces

# API
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
